# Browser-safe
NEXT_PUBLIC_AETHER_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_AETHER_APP_URL=http://localhost:3000
NEXT_PUBLIC_AETHER_EXPLORER_URL=https://sepolia.etherscan.io

# API, database, queues, and authentication
NODE_ENV=development
PORT=4000
AETHER_WEB_ORIGINS=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27018/aether?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
AETHER_ACCESS_TOKEN_SECRET=
AETHER_REFRESH_TOKEN_SECRET=
AETHER_COOKIE_SECRET=
AETHER_CSRF_SECRET=
AETHER_CREDENTIAL_ENCRYPTION_KEY=
AETHER_ACCESS_TOKEN_TTL_SECONDS=900
AETHER_REFRESH_TOKEN_TTL_SECONDS=2592000

# Local Mailpit; use hosted SMTP values outside local development
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Aether Local <aether@localhost>

# Ethereum Sepolia only
AETHER_CHAIN_ID=11155111
AETHER_MAINNET_DISABLED=true
AETHER_RPC_URL=
AETHER_RPC_LOG_BLOCK_RANGE=10
AETHER_RPC_RECOVERY_MAX_BLOCKS=500
AETHER_SECONDARY_RPC_URL=
AETHER_FINALITY_CONFIRMATIONS=12
AETHER_MAX_ORACLE_AGE=3600
AETHER_DEPLOYMENT_REGISTRY_PATH=packages/contracts/deployments/11155111.json
AETHER_CONTRACT_ADMIN_ADDRESS=
AETHER_EXECUTOR_ADDRESS=
AETHER_DRIFT_ACTOR_ADDRESS=
AETHER_FIXTURE_ADMIN_ADDRESS=
AETHER_RECORD_DEPLOYMENT=false

# KeeperHub Direct Execution
KEEPERHUB_BASE_URL=https://app.keeperhub.com/api
KEEPERHUB_API_KEY=
KEEPERHUB_REQUEST_TIMEOUT_MS=10000

# GitHub App (read-only)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_SETUP_URL=http://localhost:4000/v1/github/callback

# Advisory-only OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REQUEST_TIMEOUT_MS=20000

# Protected live acceptance account (created through the Aether UI)
LIVE_TEST_EMAIL=
LIVE_TEST_PASSWORD=
