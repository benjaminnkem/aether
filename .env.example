NEXT_PUBLIC_AETHER_DATA_MODE=mock
NEXT_PUBLIC_AETHER_API_URL=/v1
NEXT_PUBLIC_AETHER_GITHUB_URL=https://github.com/example/aether
NEXT_PUBLIC_AETHER_EXPLORER_URL=https://sepolia.etherscan.io

# API and worker (server-only)
PORT=4000
NODE_ENV=development
AETHER_AUTH_MODE=development
AETHER_JWT_SECRET=replace-with-at-least-32-random-characters
AETHER_PERSISTENCE_MODE=mongo
MONGODB_URI=mongodb://127.0.0.1:27017/aether?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
AETHER_WEB_ORIGINS=http://localhost:3000
AETHER_ORGANIZATION_ID=org-arcadia
AETHER_PROTOCOL_ID=arcadia
AETHER_PROVIDER_MODE=mock

# Required only when AETHER_PROVIDER_MODE=live
AETHER_RPC_URL=
AETHER_ORACLE_READ_CALLDATA=0x994c821d
KEEPERHUB_BASE_URL=
KEEPERHUB_API_TOKEN=
GITHUB_READ_TOKEN=

# Public contract deployment configuration (never signing material)
AETHER_CONTRACT_ADMIN_ADDRESS=
AETHER_EXECUTOR_ADDRESS=
AETHER_DRIFT_ACTOR_ADDRESS=
AETHER_FIXTURE_ADMIN_ADDRESS=
AETHER_UNPRIVILEGED_ADDRESS=
AETHER_MAX_ORACLE_AGE=3600
AETHER_RECORD_DEPLOYMENT=false
