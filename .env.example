# Browser-safe values
NEXT_PUBLIC_AETHER_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_AETHER_APP_URL=http://localhost:3000
NEXT_PUBLIC_AETHER_EXPLORER_URL=https://sepolia.etherscan.io
AETHER_AGENT_RUNTIME_ORIGIN=http://localhost:3001

# Savings and lending agents are exposed through http://localhost:3000/agent/*.
# Create a scoped Aether key with missions:read, missions:create, runs:create,
# runs:read, and receipts:read. This key is read only by the Savings server.
SAVINGS_AETHER_API_URL=http://localhost:4000/v1
SAVINGS_AETHER_API_KEY=
SAVINGS_APP_ORIGIN=http://localhost:3000
SAVINGS_APP_ACCESS_TOKEN=
SAVINGS_SESSION_SECRET=
SAVINGS_LIVE_EXECUTION_ENABLED=false
SAVINGS_VAULT_ADDRESS=
SAVINGS_TOKEN_ADDRESS=
SAVINGS_TOKEN_SYMBOL=USDC
SAVINGS_TOKEN_DECIMALS=6
SAVINGS_MIN_AMOUNT=1
SAVINGS_MAX_AMOUNT=100
SAVINGS_KEEPERHUB_EXECUTOR_ADDRESS=
SAVINGS_EXPLORER_URL=https://sepolia.etherscan.io

# Real Sepolia lending protocol integration. Verify these addresses against the
# protocol's official deployment registry before enabling live execution.
LENDING_LIVE_EXECUTION_ENABLED=false
LENDING_POOL_ADDRESS=
LENDING_COLLATERAL_TOKEN_ADDRESS=
LENDING_COLLATERAL_SYMBOL=LINK
LENDING_COLLATERAL_DECIMALS=18
LENDING_MIN_COLLATERAL=1
LENDING_MAX_COLLATERAL=10
LENDING_BORROW_TOKEN_ADDRESS=
LENDING_BORROW_SYMBOL=USDC
LENDING_BORROW_DECIMALS=6
LENDING_BORROW_AMOUNT=1
LENDING_MIN_BORROW=0.1
LENDING_MAX_BORROW=5
LENDING_ATOKEN_ADDRESS=
LENDING_VARIABLE_DEBT_TOKEN_ADDRESS=

# API and MongoDB replica set
NODE_ENV=development
PORT=4000
AETHER_WEB_ORIGINS=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27018/aether?replicaSet=rs0
MONGODB_MAX_POOL_SIZE=20
AETHER_BODY_LIMIT=256kb
AETHER_ACCESS_TOKEN_SECRET=
AETHER_REFRESH_TOKEN_SECRET=
AETHER_COOKIE_SECRET=
AETHER_CSRF_SECRET=
AETHER_CREDENTIAL_ENCRYPTION_KEY=
AETHER_ACCESS_TOKEN_TTL_SECONDS=900
AETHER_REFRESH_TOKEN_TTL_SECONDS=2592000

# Mail
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Aether Local <aether@localhost>

# Ethereum Sepolia verification
AETHER_ALLOWED_CHAIN_IDS=11155111
SEPOLIA_RPC_PRIMARY_URL=
SEPOLIA_RPC_SECONDARY_URL=
SEPOLIA_RPC_PRIMARY_LOG_RANGE=10
SEPOLIA_RPC_SECONDARY_LOG_RANGE=10
RPC_TIMEOUT_MS=10000
AETHER_MIN_CONFIRMATIONS=3
AETHER_RPC_TRANSIENT_MAX_RETRIES=12
AETHER_RECONCILIATION_WINDOW_MS=300000

# KeeperHub Direct Execution
KEEPERHUB_BASE_URL=https://app.keeperhub.com/api
KEEPERHUB_API_KEY=
KEEPERHUB_REQUEST_TIMEOUT_MS=60000

# Optional incident summaries; no transaction authority
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_ALLOWLIST=llama-3.3-70b-versatile,qwen/qwen3.6-27b
GROQ_TIMEOUT_MS=15000
GROQ_MAX_COMPLETION_TOKENS=1200

# Fixed public demo
DEMO_LIVE_EXECUTION_ENABLED=false
DEMO_VAULT_ADDRESS=
DEMO_FIXED_AMOUNT=100
DEMO_MAX_AMOUNT=100
DEMO_RUNS_PER_HOUR=2
DEMO_GLOBAL_RUNS_PER_HOUR=20
KEEPERHUB_EXECUTOR_ADDRESS=

# Only the explicitly named live command reads this flag
LIVE_SEPOLIA_TESTS=false
