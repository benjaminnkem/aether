{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "AETHER_ACCESS_TOKEN_SECRET",
    "AETHER_ACCESS_TOKEN_TTL_SECONDS",
    "AETHER_REFRESH_TOKEN_SECRET",
    "AETHER_REFRESH_TOKEN_TTL_SECONDS",
    "AETHER_COOKIE_SECRET",
    "AETHER_CSRF_SECRET",
    "AETHER_CREDENTIAL_ENCRYPTION_KEY",
    "AETHER_CHAIN_ID",
    "AETHER_RPC_URL",
    "AETHER_RPC_LOG_BLOCK_RANGE",
    "AETHER_RPC_RECOVERY_MAX_BLOCKS",
    "AETHER_SECONDARY_RPC_URL",
    "AETHER_ORACLE_READ_CALLDATA",
    "AETHER_CONTRACT_ADMIN_ADDRESS",
    "AETHER_DRIFT_ACTOR_ADDRESS",
    "AETHER_EXECUTOR_ADDRESS",
    "AETHER_FINALITY_CONFIRMATIONS",
    "AETHER_FIXTURE_ADMIN_ADDRESS",
    "AETHER_MAX_ORACLE_AGE",
    "AETHER_MAINNET_DISABLED",
    "AETHER_DEPLOYMENT_REGISTRY_PATH",
    "AETHER_RECORD_DEPLOYMENT",
    "AETHER_RUN_INTEGRATION",
    "AETHER_UNPRIVILEGED_ADDRESS",
    "AETHER_WEB_ORIGINS",
    "GITHUB_APP_ID",
    "GITHUB_APP_SLUG",
    "GITHUB_SETUP_URL",
    "GITHUB_PRIVATE_KEY_BASE64",
    "GITHUB_WEBHOOK_SECRET",
    "KEEPERHUB_API_KEY",
    "KEEPERHUB_BASE_URL",
    "KEEPERHUB_REQUEST_TIMEOUT_MS",
    "LIVE_TESTNET_ACCEPTANCE",
    "LIVE_TEST_EMAIL",
    "LIVE_TEST_PASSWORD",
    "MONGODB_URI",
    "NEXT_PUBLIC_AETHER_API_URL",
    "NEXT_PUBLIC_AETHER_APP_URL",
    "NEXT_PUBLIC_AETHER_EXPLORER_URL",
    "NODE_ENV",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "OPENAI_REQUEST_TIMEOUT_MS",
    "PORT",
    "REDIS_URL",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "SMTP_FROM"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "artifacts/server/**",
        "dist/**",
        "out/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
