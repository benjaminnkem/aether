{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "AETHER_AUTH_MODE",
    "AETHER_CREDENTIAL_ENCRYPTION_KEY",
    "AETHER_JWT_SECRET",
    "AETHER_ORGANIZATION_ID",
    "AETHER_OPENAI_ENABLED",
    "AETHER_PERSISTENCE_MODE",
    "AETHER_PROTOCOL_ID",
    "AETHER_PROVIDER_MODE",
    "AETHER_RPC_URL",
    "AETHER_ORACLE_READ_CALLDATA",
    "AETHER_CONTRACT_ADMIN_ADDRESS",
    "AETHER_DRIFT_ACTOR_ADDRESS",
    "AETHER_EXECUTOR_ADDRESS",
    "AETHER_FIXTURE_ADMIN_ADDRESS",
    "AETHER_MAX_ORACLE_AGE",
    "AETHER_RECORD_DEPLOYMENT",
    "AETHER_UNPRIVILEGED_ADDRESS",
    "AETHER_WEB_ORIGINS",
    "GITHUB_READ_TOKEN",
    "KEEPERHUB_API_TOKEN",
    "KEEPERHUB_BASE_URL",
    "KEEPERHUB_WORKFLOW_ID",
    "MONGODB_URI",
    "NEXT_PUBLIC_AETHER_API_URL",
    "NODE_ENV",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "PORT",
    "REDIS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "artifacts/server/**",
        "dist/**",
        "out/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
