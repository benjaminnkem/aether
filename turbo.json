{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "AETHER_ACCESS_TOKEN_SECRET",
    "AETHER_REFRESH_TOKEN_SECRET",
    "AETHER_COOKIE_SECRET",
    "AETHER_CSRF_SECRET",
    "AETHER_CREDENTIAL_ENCRYPTION_KEY",
    "AETHER_ACCESS_TOKEN_TTL_SECONDS",
    "AETHER_REFRESH_TOKEN_TTL_SECONDS",
    "AETHER_BODY_LIMIT",
    "AETHER_SYNC_REQUEST_TIMEOUT_MS",
    "AETHER_RUN_INTEGRATION",
    "AETHER_ALLOWED_CHAIN_IDS",
    "AETHER_WEB_ORIGINS",
    "MONGODB_URI",
    "MONGODB_MAX_POOL_SIZE",
    "SEPOLIA_RPC_PRIMARY_URL",
    "SEPOLIA_RPC_SECONDARY_URL",
    "SEPOLIA_RPC_PRIMARY_LOG_RANGE",
    "SEPOLIA_RPC_SECONDARY_LOG_RANGE",
    "AETHER_MIN_CONFIRMATIONS",
    "KEEPERHUB_API_KEY",
    "KEEPERHUB_BASE_URL",
    "GROQ_API_KEY",
    "GROQ_MODEL",
    "GROQ_MODEL_ALLOWLIST",
    "DEMO_LIVE_EXECUTION_ENABLED",
    "DEMO_VAULT_ADDRESS",
    "DEMO_FIXED_AMOUNT",
    "DEMO_MAX_AMOUNT",
    "DEMO_RUNS_PER_HOUR",
    "DEMO_GLOBAL_RUNS_PER_HOUR",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "SMTP_FROM",
    "LIVE_SEPOLIA_TESTS",
    "LIVE_TEST_EMAIL",
    "LIVE_TEST_PASSWORD",
    "NEXT_PUBLIC_AETHER_API_URL",
    "NEXT_PUBLIC_AETHER_APP_URL",
    "NEXT_PUBLIC_AETHER_EXPLORER_URL",
    "NODE_ENV",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "artifacts/server/**",
        "dist/**",
        "out/**"
      ]
    },
    "lint": { "dependsOn": ["^lint"] },
    "check-types": { "dependsOn": ["^check-types"] },
    "test": { "dependsOn": ["build", "^build"] },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true }
  }
}
