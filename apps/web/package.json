{
  "name": "@aether/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert '@visual|@live'",
    "test:e2e:live": "LIVE_SEPOLIA_TESTS=true playwright test --grep @live",
    "test:accessibility": "playwright test e2e/accessibility.spec.ts",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots"
  },
  "dependencies": {
    "@aether/sdk": "workspace:*",
    "@aether/shared": "workspace:*",
    "@aether/ui": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "dotenv": "^17.2.3",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.62.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.1",
    "jsdom": "28.1.0",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
