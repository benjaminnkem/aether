{
  "name": "@aether/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run --exclude test/api.integration.test.ts",
    "test:integration": "AETHER_RUN_INTEGRATION=1 vitest run test/api.integration.test.ts",
    "test:contract": "vitest run test/api.contract.test.ts",
    "security:check": "vitest run test/security.test.ts"
  },
  "dependencies": {
    "@aether/backend": "workspace:*",
    "@aether/shared": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "11.0.3",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.2.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "helmet": "8.1.0",
    "mongoose": "8.24.2",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "11.1.28",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "6.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "supertest": "7.2.2",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
